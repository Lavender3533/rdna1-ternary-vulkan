+                const FLOAT_TYPE d0 = FLOAT_TYPE(unpackHalf2x16(data_a_u32[wb0 + 6u] >> 16u).x);
+                const FLOAT_TYPE d1 = FLOAT_TYPE(unpackHalf2x16(data_a_u32[wb1 + 6u] >> 16u).x);
+
+                uint x = ((w0 >> shift) & 0xFFu) | (((w1 >> shift) & 0xFFu) << 16u);
+                FLOAT_TYPE acc0[NUM_COLS];
