+                    [[unroll]] for (uint j = 0u; j < NUM_COLS; ++j) {
+                        acc0[j] = fma(tl, y[j][t], acc0[j]);
+                        acc1[j] = fma(th, y[j][t], acc1[j]);
                     }
+                    x = m & 0x00FF00FFu;
                 }
-            }
-        }
 
-        if (h == 0u) {
-            vec4 qh0[NUM_ROWS], qh1[NUM_ROWS];
