 ggml/src/ggml-vulkan/ggml-vulkan.cpp          |  29 ++-
 .../vulkan-shaders/mul_mat_vec_ptq1_0.comp    | 190 +++++++-----------
 2 files changed, 99 insertions(+), 120 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 108edfe..c5c7664 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -2917,6 +2917,31 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
     static constexpr uint32_t mul_mat_vec_num_bindings = 5;
     static constexpr uint32_t mul_mat_vec_id_num_bindings = 6;
 
+    // Rows per workgroup for the dedicated PTQ1_0 mat-vec. 16 was measured best on RDNA1 (RX 5700 XT);
+    // other architectures keep the previous default until measured. GGML_VK_PTQ1_ROWS overrides.
+    const uint32_t ptq1_rows = [&]() {
+        const char * s = getenv("GGML_VK_PTQ1_ROWS");
+        const int v = s ? atoi(s) : 0;
+        if (v > 0) {
+            return (uint32_t) v;
+        }
+        return device->architecture == AMD_RDNA1 ? 16u : 2 * rm_stdq;
+    }();
+    // Fewer rows as the column count grows, so the per-thread accumulators stay in registers.
+    const uint32_t ptq1_min_rows = [&]() {
+        const char * s = getenv("GGML_VK_PTQ1_MIN_ROWS");
+        const int v = s ? atoi(s) : 0;
+        return v > 0 ? (uint32_t) v : std::min(4u, ptq1_rows);
+    }();
+    auto const ptq1_rows_for = [&](uint32_t i) {
+        uint32_t c = i + 1, r = ptq1_rows;
+        while (c > 1 && r > ptq1_min_rows) {
+            r /= 2;
+            c = (c + 1) / 2;
+        }
+        return r;
+    };
+
